class Solution {
    public int maxArea(int[] height) {

        int left = 0;
        int right = height.length - 1;
        int maximum = 0;

        while (left < right) {

            int c = Math.min(height[left], height[right]) * (right - left);
            maximum = Math.max(maximum, c);

            if (height[left] < height[right]) {
                left++;
            } else {
                right--;
            }
        }

        return maximum;
    }
}
